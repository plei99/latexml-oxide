<?xml version="1.0" encoding="UTF-8"?>
<?latexml class="article"?>
<?latexml package="amsmath"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <section inlist="toc" xml:id="S1">
    <tags>
      <tag>1</tag>
      <tag role="refnum">1</tag>
      <tag role="typerefnum">§1</tag>
    </tags>
    <title><tag close=" ">1</tag>The macro idiom</title>
    <para xml:id="S1.p1">
      <p><Math mode="inline" tex="\mathopen{}\mathclose{{\left(x\right)}}" text="x" xml:id="S1.p1.m1">
          <XMath>
            <XMDual>
              <XMRef idref="S1.p1.m1.1"/>
              <XMWrap>
                <XMTok role="OPEN" stretchy="true">(</XMTok>
                <XMTok font="italic" role="UNKNOWN" xml:id="S1.p1.m1.1">x</XMTok>
                <XMTok role="CLOSE" stretchy="true">)</XMTok>
              </XMWrap>
            </XMDual>
          </XMath>
        </Math></p>
    </para>
    <para xml:id="S1.p2">
      <p><Math mode="inline" tex="f\mathopen{}\mathclose{{\left(x\right)}}" text="f@(x)" xml:id="S1.p2.m1">
          <XMath>
            <XMApp>
              <XMTok font="italic" role="UNKNOWN">f</XMTok>
              <XMDual>
                <XMRef idref="S1.p2.m1.1"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="true">(</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S1.p2.m1.1">x</XMTok>
                  <XMTok role="CLOSE" stretchy="true">)</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math></p>
    </para>
    <para xml:id="S1.p3">
      <p><Math mode="inline" tex="a\mathopen{}\mathclose{{\left(x+y\right)}}=b" text="a@(x + y) = b" xml:id="S1.p3.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="equals" role="RELOP">=</XMTok>
              <XMApp>
                <XMTok font="italic" role="UNKNOWN">a</XMTok>
                <XMDual>
                  <XMRef idref="S1.p3.m1.1"/>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="true">(</XMTok>
                    <XMApp xml:id="S1.p3.m1.1">
                      <XMTok meaning="plus" role="ADDOP">+</XMTok>
                      <XMTok font="italic" role="UNKNOWN">x</XMTok>
                      <XMTok font="italic" role="UNKNOWN">y</XMTok>
                    </XMApp>
                    <XMTok role="CLOSE" stretchy="true">)</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
              <XMTok font="italic" role="UNKNOWN">b</XMTok>
            </XMApp>
          </XMath>
        </Math></p>
    </para>
    <para xml:id="S1.p4">
      <p><Math mode="inline" tex="\mathopen{}\mathclose{{\left|\frac{1}{x}\right|}}" text="absolute-value@(1 / x)" xml:id="S1.p4.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="absolute-value"/>
                <XMRef idref="S1.p4.m1.1"/>
              </XMApp>
              <XMWrap>
                <XMTok role="OPEN" stretchy="true">|</XMTok>
                <XMApp xml:id="S1.p4.m1.1">
                  <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
                  <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">x</XMTok>
                </XMApp>
                <XMTok role="CLOSE" stretchy="true">|</XMTok>
              </XMWrap>
            </XMDual>
          </XMath>
        </Math></p>
    </para>
    <para xml:id="S1.p5">
      <p><Math mode="inline" tex="\mathopen{}\mathclose{{\left[a,b\right)}}" text="closed-open-interval@(a, b)" xml:id="S1.p5.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="closed-open-interval"/>
                <XMRef idref="S1.p5.m1.1"/>
                <XMRef idref="S1.p5.m1.2"/>
              </XMApp>
              <XMWrap>
                <XMTok role="OPEN" stretchy="true">[</XMTok>
                <XMTok font="italic" role="UNKNOWN" xml:id="S1.p5.m1.1">a</XMTok>
                <XMTok role="PUNCT">,</XMTok>
                <XMTok font="italic" role="UNKNOWN" xml:id="S1.p5.m1.2">b</XMTok>
                <XMTok role="CLOSE" stretchy="true">)</XMTok>
              </XMWrap>
            </XMDual>
          </XMath>
        </Math></p>
    </para>
    <para xml:id="S1.p6">
      <p><Math mode="inline" tex="\mathopen{}\mathclose{{\left\{y\middle|y&gt;0\right\}}}" text="conditional-set@(y, y &gt; 0)" xml:id="S1.p6.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="conditional-set"/>
                <XMRef idref="S1.p6.m1.1"/>
                <XMRef idref="S1.p6.m1.2"/>
              </XMApp>
              <XMWrap>
                <XMTok role="OPEN" stretchy="true">{</XMTok>
                <XMTok font="italic" role="UNKNOWN" xml:id="S1.p6.m1.1">y</XMTok>
                <XMTok role="MIDDLE" role_side="middle" stretchy="true">|</XMTok>
                <XMApp xml:id="S1.p6.m1.2">
                  <XMTok meaning="greater-than" role="RELOP">&gt;</XMTok>
                  <XMTok font="italic" role="UNKNOWN">y</XMTok>
                  <XMTok meaning="0" role="NUMBER">0</XMTok>
                </XMApp>
                <XMTok role="CLOSE" stretchy="true">}</XMTok>
              </XMWrap>
            </XMDual>
          </XMath>
        </Math></p>
    </para>
    <para xml:id="S1.p7">
      <p><Math mode="inline" tex="\mathopen{}\mathclose{{\left(x\right)}}^{2}" text="x ^ 2" xml:id="S1.p7.m1">
          <XMath>
            <XMApp>
              <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
              <XMDual>
                <XMRef idref="S1.p7.m1.1"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="true">(</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S1.p7.m1.1">x</XMTok>
                  <XMTok role="CLOSE" stretchy="true">)</XMTok>
                </XMWrap>
              </XMDual>
              <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
            </XMApp>
          </XMath>
        </Math></p>
    </para>
    <para xml:id="S1.p8">
      <p><Math mode="inline" tex="\mathopen{}\mathclose{{\left.f(x)\right|}}_{0}^{1}" text="evaluated-at@(f@(x), 0, 1)" xml:id="S1.p8.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="evaluated-at"/>
                <XMRef idref="S1.p8.m1.1"/>
                <XMRef idref="S1.p8.m1.3"/>
                <XMRef idref="S1.p8.m1.4"/>
              </XMApp>
              <XMApp>
                <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                <XMApp>
                  <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                  <XMWrap>
                    <XMApp xml:id="S1.p8.m1.1">
                      <XMTok font="italic" role="UNKNOWN">f</XMTok>
                      <XMDual>
                        <XMRef idref="S1.p8.m1.2"/>
                        <XMWrap>
                          <XMTok role="OPEN" stretchy="false">(</XMTok>
                          <XMTok font="italic" role="UNKNOWN" xml:id="S1.p8.m1.2">x</XMTok>
                          <XMTok role="CLOSE" stretchy="false">)</XMTok>
                        </XMWrap>
                      </XMDual>
                    </XMApp>
                    <XMTok role="CLOSE" stretchy="true">|</XMTok>
                  </XMWrap>
                  <XMTok fontsize="70%" meaning="0" role="NUMBER" xml:id="S1.p8.m1.3">0</XMTok>
                </XMApp>
                <XMTok fontsize="70%" meaning="1" role="NUMBER" xml:id="S1.p8.m1.4">1</XMTok>
              </XMApp>
            </XMDual>
          </XMath>
        </Math></p>
    </para>
    <para xml:id="S1.p9">
      <p><Math mode="inline" tex="\mathopen{}\mathclose{{\left(\mathopen{}\mathclose{{\left(x\right)}}+1\right)}}" text="x + 1" xml:id="S1.p9.m1">
          <XMath>
            <XMDual>
              <XMRef idref="S1.p9.m1.1"/>
              <XMWrap>
                <XMTok role="OPEN" stretchy="true">(</XMTok>
                <XMApp xml:id="S1.p9.m1.1">
                  <XMTok meaning="plus" role="ADDOP">+</XMTok>
                  <XMDual>
                    <XMRef idref="S1.p9.m1.2"/>
                    <XMWrap>
                      <XMTok role="OPEN" stretchy="true">(</XMTok>
                      <XMTok font="italic" role="UNKNOWN" xml:id="S1.p9.m1.2">x</XMTok>
                      <XMTok role="CLOSE" stretchy="true">)</XMTok>
                    </XMWrap>
                  </XMDual>
                  <XMTok meaning="1" role="NUMBER">1</XMTok>
                </XMApp>
                <XMTok role="CLOSE" stretchy="true">)</XMTok>
              </XMWrap>
            </XMDual>
          </XMath>
        </Math></p>
    </para>
  </section>
  <section inlist="toc" xml:id="S2">
    <tags>
      <tag>2</tag>
      <tag role="refnum">2</tag>
      <tag role="typerefnum">§2</tag>
    </tags>
    <title><tag close=" ">2</tag>Redefined left and right</title>
    <para xml:id="S2.p1">
      <p><Math mode="inline" tex="f\mathopen{}\mathclose{{\left(x\right)}}" text="f@(x)" xml:id="S2.p1.m1">
          <XMath>
            <XMApp>
              <XMTok font="italic" role="UNKNOWN">f</XMTok>
              <XMDual>
                <XMRef idref="S2.p1.m1.1"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="true">(</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S2.p1.m1.1">x</XMTok>
                  <XMTok role="CLOSE" stretchy="true">)</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math></p>
    </para>
    <para xml:id="S2.p2">
      <p><Math mode="inline" tex="\sum_{k}\mathopen{}\mathclose{{\left(k+\frac{1}{2}\right)}}x^{k}" text="(sum _ k)@((k + 1 / 2) * x ^ k)" xml:id="S2.p2.m1">
          <XMath>
            <XMApp>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok mathstyle="text" meaning="sum" role="SUMOP" scriptpos="post">∑</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">k</XMTok>
              </XMApp>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMDual>
                  <XMRef idref="S2.p2.m1.1"/>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="true">(</XMTok>
                    <XMApp xml:id="S2.p2.m1.1">
                      <XMTok meaning="plus" role="ADDOP">+</XMTok>
                      <XMTok font="italic" role="UNKNOWN">k</XMTok>
                      <XMApp>
                        <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
                        <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
                        <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                      </XMApp>
                    </XMApp>
                    <XMTok role="CLOSE" stretchy="true">)</XMTok>
                  </XMWrap>
                </XMDual>
                <XMApp>
                  <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                  <XMTok font="italic" role="UNKNOWN">x</XMTok>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">k</XMTok>
                </XMApp>
              </XMApp>
            </XMApp>
          </XMath>
        </Math></p>
    </para>
  </section>
  <section inlist="toc" xml:id="S3">
    <tags>
      <tag>3</tag>
      <tag role="refnum">3</tag>
      <tag role="typerefnum">§3</tag>
    </tags>
    <title><tag close=" ">3</tag>A split row</title>
    <para xml:id="S3.p1">
      <equation xml:id="S3.E1">
        <tags>
          <tag>(1)</tag>
          <tag role="refnum">1</tag>
        </tags>
        <Math mode="display" tex="\begin{split}a&amp;=f\mathopen{}\mathclose{\left(x\right)}\\&#10;&amp;=g\end{split}" text="a = f@(x) = g" xml:id="S3.E1.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="multirelation"/>
                <XMRef idref="S3.E1.m1.1"/>
                <XMRef idref="S3.E1.m1.2"/>
                <XMApp>
                  <XMRef idref="S3.E1.m1.3"/>
                  <XMRef idref="S3.E1.m1.5"/>
                </XMApp>
                <XMRef idref="S3.E1.m1.7"/>
                <XMRef idref="S3.E1.m1.8"/>
              </XMApp>
              <XMArray colsep="0pt" name="aligned">
                <XMRow>
                  <XMCell align="right">
                    <XMTok font="italic" role="UNKNOWN" xml:id="S3.E1.m1.1">a</XMTok>
                  </XMCell>
                  <XMCell align="left">
                    <XMApp>
                      <XMTok meaning="equals" role="RELOP" xml:id="S3.E1.m1.2">=</XMTok>
                      <XMTok meaning="absent"/>
                      <XMApp>
                        <XMTok font="italic" role="UNKNOWN" xml:id="S3.E1.m1.3">f</XMTok>
                        <XMWrap>
                          <XMTok role="OPEN" stretchy="true">(</XMTok>
                          <XMTok font="italic" role="UNKNOWN" xml:id="S3.E1.m1.5">x</XMTok>
                          <XMTok role="CLOSE" stretchy="true">)</XMTok>
                        </XMWrap>
                      </XMApp>
                    </XMApp>
                  </XMCell>
                </XMRow>
                <XMRow>
                  <XMCell/>
                  <XMCell align="left">
                    <XMApp>
                      <XMTok meaning="equals" role="RELOP" xml:id="S3.E1.m1.7">=</XMTok>
                      <XMTok meaning="absent"/>
                      <XMTok font="italic" role="UNKNOWN" xml:id="S3.E1.m1.8">g</XMTok>
                    </XMApp>
                  </XMCell>
                </XMRow>
              </XMArray>
            </XMDual>
          </XMath>
        </Math>
      </equation>
    </para>
  </section>
  <section inlist="toc" xml:id="S4">
    <tags>
      <tag>4</tag>
      <tag role="refnum">4</tag>
      <tag role="typerefnum">§4</tag>
    </tags>
    <title><tag close=" ">4</tag>Empty class atoms</title>
    <para xml:id="S4.p1">
      <p><Math mode="inline" tex="f\mathopen{}(x)" text="f@(x)" xml:id="S4.p1.m1">
          <XMath>
            <XMApp>
              <XMTok font="italic" role="UNKNOWN">f</XMTok>
              <XMDual>
                <XMRef idref="S4.p1.m1.1"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S4.p1.m1.1">x</XMTok>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math></p>
    </para>
    <para xml:id="S4.p2">
      <p><Math mode="inline" tex="a\mathclose{}b" text="a * b" xml:id="S4.p2.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMTok font="italic" role="UNKNOWN">b</XMTok>
            </XMApp>
          </XMath>
        </Math></p>
    </para>
  </section>
  <section inlist="toc" xml:id="S5">
    <tags>
      <tag>5</tag>
      <tag role="refnum">5</tag>
      <tag role="typerefnum">§5</tag>
    </tags>
    <title><tag close=" ">5</tag>A wrap of two fences</title>
    <para xml:id="S5.p1">
      <p><Math mode="inline" tex="\mathclose{\left(a\right)+\left(b\right)}" text="a + b" xml:id="S5.p1.m1">
          <XMath>
            <XMApp role="CLOSE">
              <XMTok meaning="plus" role="ADDOP">+</XMTok>
              <XMDual>
                <XMRef idref="S5.p1.m1.1"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="true">(</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S5.p1.m1.1">a</XMTok>
                  <XMTok role="CLOSE" stretchy="true">)</XMTok>
                </XMWrap>
              </XMDual>
              <XMDual>
                <XMRef idref="S5.p1.m1.2"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="true">(</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S5.p1.m1.2">b</XMTok>
                  <XMTok role="CLOSE" stretchy="true">)</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math></p>
    </para>
  </section>
</document>
